# ── Option A: OpenAI (best for the live demo) ──────────────
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-key-here
# LLM_MODEL=gpt-4o-mini

# ── Option B: Ollama — free, runs on your laptop ───────────
#   1. install from https://ollama.com   2. ollama pull qwen2.5
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5

# ── Option C: any OpenAI-compatible provider ───────────────
#   (Groq, Google Gemini, OpenRouter, LM Studio …)
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=your-key
# LLM_MODEL=llama-3.3-70b-versatile

# Skip the y/N approval prompts (only for rehearsed demos)
# AUTO_APPROVE=1
